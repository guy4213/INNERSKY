generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id            Int      @id @default(autoincrement())
  nameHe        String   @default("")
  nameEn        String   @default("")
  descriptionHe String   @default("")
  descriptionEn String   @default("")
  imageUrl      String   @default("")
  orderIndex    Int      @default(0)
  visible       Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model ContactSubmission {
  id                   Int      @id @default(autoincrement())
  name                 String
  company              String?
  email                String
  phone                String?
  message              String
  status               String   @default("new")
  notes                String?
  consentGivenAt       DateTime?
  privacyPolicyVersion String?
  createdAt            DateTime @default(now())
}

model Article {
  id        Int      @id @default(autoincrement())
  titleHe   String   @default("")
  titleEn   String   @default("")
  contentHe String   @default("")
  contentEn String   @default("")
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model SectionSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Service {
  id         Int      @id @default(autoincrement())
  icon       String   @default("assignment")
  color      String   @default("text-primary")
  titleHe    String   @default("")
  titleEn    String   @default("")
  descHe     String   @default("")
  descEn     String   @default("")
  includesHe String   @default("")
  includesEn String   @default("")
  resultHe   String   @default("")
  resultEn   String   @default("")
  featured   Boolean  @default(false)
  orderIndex Int      @default(0)
  visible    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}
